{
  "name": "maraton",
  "version": "0.1.0",
  "description": "Marathon training app connected to the Strava API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "summary": "node --env-file-if-exists=.env src/summary.js",
    "token": "node --env-file-if-exists=.env scripts/token.js"
  },
  "license": "MIT"
}
