# Create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback
# Comma-separated scopes: read, read_all, profile:read_all, activity:read, activity:read_all, activity:write
STRAVA_SCOPES=read,activity:read_all
PORT=3000
# Optional: lets the app reach Strava without the browser login (used by GitHub Actions).
# Copy "refresh_token" from .strava-tokens.json after connecting once.
STRAVA_REFRESH_TOKEN=
